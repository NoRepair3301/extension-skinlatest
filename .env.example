# Extension build config for Skinly Plus (names only; real values go in .env.local, which is gitignored).
# Missing values: the build says "Plus not available in this build" and Free works as before.
VITE_SUPABASE_URL=
# The project's publishable key (sb_publishable_...) or the legacy anon key. Public by design.
VITE_SUPABASE_ANON_KEY=
# Printed by: node scripts/gen-entitlement-keys.mjs
VITE_ENTITLEMENT_PUBKEY=
