{
  "name": "skinly-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --mode applier && vite build --mode applier-auto",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --quiet",
    "test": "vitest run --reporter=dot",
    "scrub": "node scripts/scrub-fixture.ts",
    "contrast": "node scripts/contrast.ts",
    "validate-dist": "node scripts/validate-dist.ts",
    "check": "npm run typecheck --silent && npm run lint --silent && npm run test --silent && npm run build --silent && npm run validate-dist --silent && npm run contrast --silent",
    "bakeoff": "node scripts/bakeoff.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "preact": "^11.1.0"
  }
}
